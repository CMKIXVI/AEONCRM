generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStatus { OPEN WON LOST }
enum ActivityType { CALL EMAIL MEETING NOTE TASK }
enum TaskStatus { TODO IN_PROGRESS DONE CANCELLED }
enum AgentConversationStatus { ACTIVE ARCHIVED }
enum AgentMessageRole { USER ASSISTANT TOOL SYSTEM }
enum AgentApprovalStatus { PENDING APPROVED REJECTED EXECUTED }
enum MembershipRole { OWNER ADMIN MEMBER }

model Tenant {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships  Membership[]
  companies    Company[]
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]
  conversations AgentConversation[]
  approvals    AgentApproval[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  messages     AgentMessage[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model Company {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  website     String?
  industry    String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]
  tasks       Task[]
  @@index([tenantId, name])
}

model Contact {
  id          String @id @default(cuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  companyId   String?
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deals       Deal[]
  activities  Activity[]
  tasks       Task[]
  @@index([tenantId, email])
  @@index([tenantId, companyId])
}

model Deal {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  value       Decimal @db.Decimal(18, 2)
  currency    String @default("INR")
  stage       String @default("QUALIFICATION")
  status      DealStatus @default(OPEN)
  probability Int @default(20)
  expectedAt  DateTime?
  companyId   String?
  contactId   String?
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities  Activity[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, status, stage])
  @@index([tenantId, companyId])
}

model Activity {
  id         String  @id @default(cuid())
  tenantId   String
  type       ActivityType
  subject    String
  body       String?
  occurredAt DateTime @default(now())
  companyId  String?
  contactId  String?
  dealId     String?
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal       Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  @@index([tenantId, occurredAt])
  @@index([tenantId, dealId])
}

model Task {
  id          String @id @default(cuid())
  tenantId    String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  companyId   String?
  contactId   String?
  dealId      String?
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, status, dueAt])
}

model AgentConversation {
  id         String @id @default(cuid())
  tenantId   String
  title      String @default("New conversation")
  status     AgentConversationStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   AgentMessage[]
  approvals  AgentApproval[]
  @@index([tenantId, status, updatedAt])
}

model AgentMessage {
  id               String @id @default(cuid())
  conversationId   String
  userId           String?
  role             AgentMessageRole
  content          String
  intent           String?
  tool             String?
  requiresApproval Boolean @default(false)
  approved         Boolean @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())
  conversation     AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  approval         AgentApproval?
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model AgentApproval {
  id             String @id @default(cuid())
  tenantId       String
  conversationId String
  messageId      String @unique
  tool           String
  arguments      Json
  status         AgentApprovalStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        AgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
  @@index([conversationId, status])
}
